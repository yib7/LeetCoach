# LeetCoach configuration. Copy to ".env" and edit, or set these in your shell.
# All eleven are optional; the defaults shown work on a machine where the
# `claude` CLI is on PATH and you want the strongest model.

# Model passed to `claude --model`. Prefer an alias (fable / opus / sonnet /
# haiku): the claude CLI resolves each alias to the latest model of that family,
# so this keeps tracking new releases with nothing to update. A full id such as
# claude-opus-5-5 pins one version. A smaller model is cheaper on your
# subscription budget; opus gives strong study material and fable is the most
# capable (and uses the most of your plan).
LEETCOACH_MODEL=opus

# Model for the short classification call that tags each run with a
# problem_type + topics. Classification is trivial, so it defaults to the
# cheapest alias regardless of LEETCOACH_MODEL; it also runs in the background
# so it never delays the streamed answer.
LEETCOACH_CLASSIFIER_MODEL=haiku

# Model for the Quick Ask lookup — the inline syntax/stdlib question box. A
# Quick Ask is a trivial lookup, so it defaults to the cheapest alias to keep
# the feature near-free regardless of LEETCOACH_MODEL.
LEETCOACH_QUICK_ASK_MODEL=haiku

# Name or absolute path of the `claude` executable. Leave as "claude" if it is
# on your PATH; otherwise point at the binary, e.g.
#   LEETCOACH_CLAUDE_BIN=C:\Users\you\AppData\Local\claude\claude.exe
LEETCOACH_CLAUDE_BIN=claude

# Wall-clock cap in seconds for a single `claude` run. If the CLI hangs (network
# stall, stuck auth prompt), the run is killed after this long and reported as a
# timeout instead of wedging forever. Must be a positive number; invalid values
# fall back to the default of 600 (10 minutes).
LEETCOACH_RUN_TIMEOUT=600

# Wall-clock cap in seconds for each Answer-mode sample-verification subprocess.
# A generated solution that hangs or loops is tree-killed after this long and
# the sample reports "timed out". Must be a positive number; invalid values fall
# back to the default of 10.
LEETCOACH_VERIFY_TIMEOUT=10

# --- Path settings ----------------------------------------------------------
# Left commented out on purpose: the real default is computed RELATIVE TO THE
# APP (so the study library always lands next to app.py no matter which
# directory you launch from). Uncommenting any line below with a relative
# value makes it resolve against your current working directory instead,
# which can silently fork your library if you ever launch from elsewhere.
# Only uncomment if you actually want to relocate it (an absolute path is
# safest).

# Where the generated study library is written. Unset, it defaults to the
# "output" directory next to the app. Gitignored.
# LEETCOACH_OUTPUT_DIR=output

# Path to the persisted topic index JSON (records what Learning has covered so
# later runs skip already-learned topics). Defaults to
# <LEETCOACH_OUTPUT_DIR>/topic_index.json.
# LEETCOACH_TOPIC_INDEX=output/topic_index.json

# Neutral working directory every `claude` call runs in, so the CLI never
# loads this project's CLAUDE.md / .claude settings and LeetCoach's saved
# sessions stay out of your normal Claude Code history. Created on demand.
# Defaults to %LOCALAPPDATA%\LeetCoach\claude-cwd on Windows and
# ~/.local/share/leetcoach/claude-cwd elsewhere (an absolute path is safest).
# LEETCOACH_CLAUDE_CWD=C:\Users\you\AppData\Local\LeetCoach\claude-cwd

# --- Opt-in switches ---------------------------------------------------------
# Both default to unset (off); uncomment to turn on.

# Set to 1/true to stop `python app.py` opening your browser on launch.
# LEETCOACH_NO_BROWSER=1

# Set to 1/true to skip loading a ".env" file next to app.py entirely (useful
# when you manage LEETCOACH_* settings purely via real shell/CI environment
# variables and want to guarantee a stray .env can never override them).
# LEETCOACH_NO_DOTENV=1

# --- Dev / test only (leave unset) -------------------------------------------
# Where the Console model picker writes its choice. Defaults to the .env next
# to app.py; the test suite and scripts/dev/run_fake.py point it at a scratch
# file. Startup always loads the .env next to the app, not this path.
# LEETCOACH_DOTENV_PATH=C:\Users\you\AppData\Local\Temp\leetcoach-scratch.env
#
# Not app settings, listed so every variable the repo reads is documented:
#   LEETCOACH_SETUP_PYTHON_EXE   setup.ps1 test hook: the Python it bootstraps with
#   LEETCOACH_AUTH_STATUS_TIMEOUT_MS, LEETCOACH_AUTH_LOGIN_TIMEOUT_MS
#                                how long ensure-claude-auth.ps1 waits for
#                                `claude auth status` (15000) and the sign-in
#                                (300000), in ms; shell env only, the launcher
#                                never reads this file
#   FAKE_CLAUDE_DELAY, FAKE_CLAUDE_FAIL, FAKE_CLAUDE_PYTHON
#                                knobs for the fake CLI in scripts/dev/ (see the
#                                headers of fake_claude.py and fake_claude.cmd)
