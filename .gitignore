# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
# The README makes .venv; this catches a venv made under the other common name
# before its thousands of files get committed.
venv/

# Env / secrets (.env.example is the tracked template)
.env
.env.*
!.env.example
*.pem
*.key

# The generated study library (the default LEETCOACH_OUTPUT_DIR, topic index
# included): personal output, not source
output/

# Local AI-assistant working files: kept on disk, never published.
# NEW_UPDATES.md and LeetCoach_Code_Audit_Report.md are the owner's local
# planning notes and audit report in the repo root.
.autopilot/
CLAUDE.md
.claude/
.superpowers/
docs/superpowers/
NEW_UPDATES.md
LeetCoach_Code_Audit_Report.md

# Contributors' editor settings and swap files (the repo ships none)
.vscode/
.idea/
*.swp
*~

# OS metadata (development is on Windows; CI also runs on macOS)
.DS_Store
Thumbs.db
