# Store text as LF in the repo and check out LF on every platform, so a Windows
# clone doesn't churn CRLF into diffs. Minified vendor assets are text too (LF).
* text=auto eol=lf

# Every text type the repo ships is named explicitly, so none of them depends on
# Git's content sniffing (text=auto) to be normalized.
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.lock  text eol=lf
*.sh    text eol=lf
.env.example   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.python-version text eol=lf
LICENSE        text eol=lf

# Windows launcher scripts (C8): cmd.exe/PowerShell are pickiest about their
# own native line ending, and core.autocrlf varies per developer machine - so
# these are pinned to CRLF here rather than left to that setting.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Real binary media: store/serve verbatim, never normalized or diffed.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.webm  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
